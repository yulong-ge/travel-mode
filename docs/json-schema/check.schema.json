{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueutil", "brightness"],
      "properties": {
        "blueutil": {"type": ["string", "null"]},
        "brightness": {"type": ["string", "null"]}
      }
    },
    "version": {
      "type": "string"
    },
    "battery": {
      "type": "object",
      "required": [
        "percent",
        "source",
        "raw"
      ],
      "properties": {
        "percent": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "enum": [
            "battery",
            "ac"
          ]
        },
        "raw": {
          "type": "string"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "kind",
          "message"
        ],
        "properties": {
          "level": {
            "enum": [
              "bad",
              "warn",
              "ok"
            ]
          },
          "kind": {
            "enum": [
              "sleep_disabled",
              "caffeinate",
              "assertion",
              "audio"
            ]
          },
          "message": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          }
        }
      }
    },
    "power": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "current",
          "recommended",
          "supported"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "current": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommended": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "cpu",
          "default_action"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "cpu": {
            "type": [
              "number",
              "null"
            ]
          },
          "default_action": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "object",
      "required": [
        "unloadable",
        "candidates",
        "kept"
      ]
    },
    "spotlight_indexing": {
      "type": "boolean"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "exists",
        "anchored_at",
        "profile"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "anchored_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scenario": {
      "enum": [
        "work",
        "away",
        null
      ]
    },
    "resurrected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "agent",
              "app",
              "pid"
            ]
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "elapsed_seconds",
        "budget_seconds",
        "limitations"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "budget_seconds": {
          "const": 15.0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "status",
              "evidence",
              "impact",
              "manual",
              "actions",
              "error",
              "elapsed_seconds"
            ],
            "properties": {
              "id": {
                "enum": [
                  "sleep_disabled",
                  "keep_awake",
                  "assertions",
                  "displays",
                  "spotlight",
                  "backup",
                  "low_power",
                  "brightness",
                  "high_cpu"
                ]
              },
              "title": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "manual": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "hit",
                  "clear",
                  "unknown"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "elapsed_seconds": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "sleep",
                        "quit",
                        "freeze",
                        "caffeinate",
                        "spotlight",
                        "low_power",
                        "brightness"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "key": {
                      "enum": [
                        "powermode",
                        "lowpowermode"
                      ]
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "process": {
                      "type": "object"
                    },
                    "command_line": {
                      "type": "string"
                    },
                    "parent": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "display_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "evidence",
              "references"
            ]
          }
        }
      }
    },
    "audit_error": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "health",
    "tool_paths"
  ],
  "oneOf": [
    {
      "required": [
        "battery",
        "blockers",
        "power",
        "apps",
        "services",
        "spotlight_indexing",
        "snapshot",
        "scenario",
        "resurrected"
      ],
      "not": {
        "required": [
          "audit_error"
        ]
      }
    },
    {
      "required": [
        "audit_error"
      ]
    }
  ]
}
