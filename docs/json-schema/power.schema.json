{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "available",
        "reason",
        "samples",
        "macos"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            null,
            "external_power",
            "no_battery",
            "charging",
            "not_discharging",
            "insufficient_samples",
            "counter_reset",
            "missing_update_marker",
            "source_changed"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "macos": {
          "type": "object",
          "required": [
            "raw",
            "minutes"
          ],
          "properties": {
            "raw": {
              "type": "string"
            },
            "minutes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "capacity_source": {
          "enum": [
            "AppleRaw",
            "BatteryData"
          ]
        },
        "power_source": {
          "enum": [
            "PowerTelemetryData.SystemLoad",
            "voltage_current",
            null
          ]
        },
        "polls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "seconds",
              "average_watts",
              "remaining_wh",
              "remaining_hours",
              "covered_seconds",
              "interval_count",
              "intervals",
              "power_source",
              "polls"
            ],
            "properties": {
              "reason": {
                "type": "null"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "average_watts": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "remaining_wh": {
                "type": "number",
                "minimum": 0
              },
              "remaining_hours": {
                "type": "number",
                "minimum": 0
              },
              "samples": {
                "type": "integer",
                "minimum": 2
              },
              "covered_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "interval_count": {
                "type": "integer",
                "minimum": 1
              },
              "power_source": {
                "enum": [
                  "PowerTelemetryData.SystemLoad",
                  "voltage_current"
                ]
              },
              "intervals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "seconds",
                    "power_source",
                    "average_watts"
                  ],
                  "properties": {
                    "seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "average_watts": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "power_source": {
                      "enum": [
                        "PowerTelemetryData.SystemLoad",
                        "voltage_current"
                      ]
                    },
                    "accumulator_samples": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "battery_average_watts": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "external_power",
                  "no_battery",
                  "charging",
                  "not_discharging",
                  "insufficient_samples",
                  "counter_reset",
                  "missing_update_marker",
                  "source_changed"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "average_watts"
                  ]
                },
                {
                  "required": [
                    "remaining_wh"
                  ]
                },
                {
                  "required": [
                    "remaining_hours"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "available",
        "reason",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "const": "failed"
        },
        "error": {
          "type": "object",
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "BatteryError"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
