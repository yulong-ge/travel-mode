{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "travel-mode cheap status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "active",
    "scenario",
    "started_at",
    "power_source",
    "language",
    "source_timeout_seconds",
    "elapsed_seconds",
    "swiftbar",
    "app_version",
    "duration_minutes",
    "battery"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "active": {
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        null,
        "work",
        "away"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "power_source": {
      "enum": [
        "ac",
        "battery",
        "ups"
      ]
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ]
    },
    "source_timeout_seconds": {
      "const": 2
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "swiftbar": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "duration_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "remaining_minutes",
        "charging_state"
      ],
      "properties": {
        "percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "remaining_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "charging_state": {
          "enum": [
            null,
            "charging",
            "charged",
            "discharging",
            "not charging",
            "finishing charge"
          ]
        },
        "system_remaining_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "average_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "estimate_source": {
          "enum": [
            null,
            "session_telemetry"
          ]
        },
        "estimate_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
