{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "travel-mode cheap status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "active",
    "scenario",
    "started_at",
    "power_source",
    "language",
    "source_timeout_seconds",
    "elapsed_seconds",
    "swiftbar",
    "app_version",
    "duration_minutes",
    "battery",
    "sleep_ready",
    "sleep_warning",
    "menubar_show",
    "menubar_hidden"
  ],
  "properties": {
    "menubar_show": {
      "enum": ["always", "session"],
      "description": "Configured menu bar visibility; defaults to always."
    },
    "menubar_hidden": {
      "type": "boolean",
      "description": "True when menubar_show is session and no session is active; swiftbar is then an empty string (a successful, hidden SwiftBar standard plugin)."
    },
    "sleep_warning": {
      "type": "boolean",
      "description": "Whether blocked sleep readiness needs a menu bar warning: true only when sleep_ready.state is blocked and a session is active or the current power source is battery. The underlying sleep_ready finding is unchanged."
    },
    "version": {
      "const": 1
    },
    "active": {
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        null,
        "work",
        "away"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "power_source": {
      "enum": [
        "ac",
        "battery",
        "ups"
      ]
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ]
    },
    "source_timeout_seconds": {
      "const": 2
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "swiftbar": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "duration_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "remaining_minutes",
        "charging_state"
      ],
      "properties": {
        "percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "remaining_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "charging_state": {
          "enum": [
            null,
            "charging",
            "charged",
            "discharging",
            "not charging",
            "finishing charge"
          ]
        },
        "system_remaining_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "average_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "estimate_source": {
          "enum": [
            null,
            "session_telemetry",
            "session_including_sleep",
            "wake_telemetry"
          ]
        },
        "estimate_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sleep_ready": {
      "type": "object",
      "required": [
        "state",
        "ready",
        "items",
        "observed_at",
        "assertions_observed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "ready",
            "idle",
            "blocked",
            "unknown"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "message"
            ],
            "properties": {
              "level": {
                "enum": [
                  "red",
                  "amber",
                  "green",
                  "unknown"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "observed_at": {
          "type": "string"
        },
        "assertions_observed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
