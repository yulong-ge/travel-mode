#body { height: 1fr; }
#log { height: 6; border: round #6680a0; border-title-align: left; }
TabPane { height: 1fr; padding: 0 1; }
TabPane VerticalScroll { height: 1fr; }
.row { height: auto; min-height: 3; align-vertical: middle; }
.cardrow { height: auto; min-height: 3; align-vertical: middle; }
.srow { width: 1fr; height: auto; padding: 0 1; }
.grow { width: 1fr; height: auto; padding: 0 1 0 0; }
.btn { min-width: 7; margin-left: 1; }
.hint { width: 1fr; height: auto; color: $text-muted; margin: 1 1; }
.card { height: auto; border: round #6680a0; margin: 0 1 1 1; padding: 0 1 1 1; }
.scope { margin: 0 1; }
Checkbox { border: none; padding: 0 1; height: auto; min-height: 1; width: 1fr; }
Button { height: 3; border: solid $primary; min-width: 9; }
.power-item { height: auto; margin: 0 1 1 1; }
.power-title { height: auto; padding: 0 1; }
.power-detail { height: auto; color: $text-muted; padding: 0 1; }
#power-list, #apps-box, #svc-box, #net-box { height: auto; }
#net-scroll { height: 1fr; min-height: 8; }
#net-actions { height: auto; }
#b-quick { min-width: 30; margin: 1 3; }
#dash-audit { color: $text-muted; padding: 0 1 1 2; }
.stat { padding: 0 1; }

.status-icon { width: 2; height: auto; padding: 0; }
.status-line { height: auto; min-height: 1; align-vertical: middle; }
