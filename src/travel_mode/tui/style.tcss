Screen { background: $surface; }
Header { height: 1; background: $surface; color: $text-muted; }
#screen-heading { height: 1; padding: 0 1; text-style: bold; }
#dash-battery { height: 1; padding: 0 1; text-overflow: ellipsis; }
#body { height: 1fr; padding: 0 1; }
Static { height: auto; }
.heading { height: 1; text-style: bold; margin-top: 1; }
.muted, .satisfied { color: $text-muted; height: auto; }
#sleep-ready, #dash-health, #plan-list { height: auto; }
.attention-line { height: auto; min-height: 1; }
.grow { width: 1fr; height: auto; }
Button { height: 1; min-height: 1; border: none; background: transparent; min-width: 5; padding: 0 1; }
Button:hover { background: $boost; }
Button:focus { text-style: bold underline; }
Button.-primary { background: $primary; color: $text; text-style: bold; }
#filters { height: 1; margin: 1 0 0 0; }
#filters Button { width: auto; margin-right: 1; }
#noise-summary { width: 1fr; text-align: left; height: auto; }
#keepalive-note { margin-top: 1; }
#q-measure { height: 1; min-height: 1; border: none; padding: 0; }
#utilities { height: 1; padding: 0 1; }
#utilities Button { margin-right: 1; }
#primary-bar { height: 3; align: right middle; padding: 0 1; }
#primary-bar Button { height: 3; min-height: 3; padding: 1 3; min-width: 18; }
#result-summary { height: auto; max-height: 2; padding: 0 1; }
#measurement-progress { height: auto; max-height: 2; padding: 0 1; }
#details-drawer { height: 9; border-top: solid $primary; padding: 0 1; }
#row-evidence { height: auto; max-height: 4; }
#log { height: 1fr; overflow-x: hidden; }
#dash-audit { height: auto; max-height: 4; }
#last-result { height: 1; color: $text-muted; padding: 0 1; text-overflow: ellipsis; }
#key-footer { height: 1; background: $surface; color: $text-muted; padding: 0 1; }
.plan-row { height: 1; min-height: 1; }
.plan-row:focus { background: $boost; }
.plan-line { height: 1; }
.plan-mark { width: 4; height: 1; min-height: 1; padding: 0; border: none; }
.plan-name { width: 24; height: 1; margin-right: 1; }
.plan-action { width: 12; min-width: 12; height: 1; padding: 0; margin-right: 1; }
.plan-reason { width: 1fr; height: 1; color: $text-muted; }
.narrow-reason { display: none; }
.plan-row.narrow { height: 2; }
.plan-row.narrow .plan-name { width: 20; }
.plan-row.narrow .wide-reason { display: none; }
.plan-row.narrow .narrow-reason { display: block; padding-left: 4; }
.row-recovery { width: auto; min-width: 5; padding: 0 1; color: $error; }
.green, .done { color: $success; }
.amber, .warning { color: $warning; }
.red, .failed { color: $error; }
.unknown, .skipped { color: $text-muted; }
#scenario-picker { padding: 1 3; }
.scenario-card { height: auto; min-height: 5; border: round #58677d; padding: 1; margin-top: 1; }
.scenario-card:focus { border: round $primary; }
#session-summary { height: auto; margin-top: 1; }
#session-revived { height: auto; color: $warning; }
#session-revived-line { height: auto; }
#b-reapply { width: auto; }

.attention-line > Button { width: auto; max-width: 36; }

.active-filter { color: $primary; text-style: bold underline; }

Screen.compact .heading { margin-top: 0; }
Screen.compact #filters { margin-top: 0; }

.satisfied { height: auto; }

Screen.short Header { display: none; }
Screen.short #sleep-ready > .heading { display: none; }
Screen.short #primary-bar { height: 1; }
Screen.short #primary-bar Button { height: 1; min-height: 1; padding: 0 2; }

#restore-pending { height: auto; }
