#body { height: 1fr; }
#log { height: 6; border: round #6680a0; border-title-align: left; }
TabPane { height: 1fr; padding: 0 1; }
TabPane VerticalScroll { height: 1fr; }
.row { height: auto; min-height: 3; align-vertical: middle; }
.cardrow { height: auto; }
# Auto grid rows measure wrapped labels before stretching the row's controls.
# Borderless controls keep single-line rows at one cell high.
#apps-box .row, #svc-box .row, #net-box .row, .cardrow {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr auto;
    grid-rows: auto;
    min-height: 1;
    grid-gutter: 0 1;
}
#apps-box .row { grid-size: 4; grid-columns: 1fr auto auto auto; }
#apps-box .row > .grow, #svc-box .row > .grow, #net-box .row > .grow, .cardrow > .grow {
    height: auto;
    content-align: left middle;
}
#apps-box .row > Button, #svc-box .row > Button, #net-box .row > Button, .cardrow > Button {
    height: 1;
    min-height: 1;
    border: none;
    margin-left: 0;
}
.srow { width: 1fr; height: auto; padding: 0 1; }
.grow { width: 1fr; height: auto; padding: 0 1 0 0; }
.btn { min-width: 7; margin-left: 1; }
.hint { width: 1fr; height: auto; color: $text-muted; margin: 1 1; }
.card { height: auto; border: round #6680a0; margin: 0 1 1 1; padding: 0 1 1 1; }
.scope { margin: 0 1; }
Checkbox { border: none; padding: 0 1; height: auto; min-height: 1; width: 1fr; }
Button { height: 3; border: solid $primary; min-width: 9; }
.power-item { height: auto; margin: 0 1 1 1; }
.power-title { height: auto; padding: 0 1; }
.power-detail { height: auto; color: $text-muted; padding: 0 1; }
#power-list, #apps-box, #svc-box, #net-box { height: auto; }
#net-scroll { height: 1fr; min-height: 8; }
#net-actions { height: auto; }
#b-quick { min-width: 30; margin: 1 3; }
#dash-audit { color: $text-muted; padding: 0 1 1 2; }
.stat { padding: 0 1; }
.health-detail { height: auto; color: $text-muted; margin-left: 2; }
.health-action { height: auto; align-horizontal: right; }
.health-action Button { height: 1; min-height: 1; border: none; margin: 0 0 1 1; }

.status-icon { width: 2; height: auto; padding: 0; }
.status-line { height: auto; min-height: 1; align-vertical: middle; }

#scenario-picker { padding: 1 3; }
.scenario-title { text-style: bold; margin-bottom: 1; }
.scenario-card { height: auto; margin-bottom: 1; padding: 1; border: round $primary; }
.scenario-card Button { width: 100%; height: 3; margin-bottom: 1; }
.scenario-card Label { width: 100%; height: auto; }
